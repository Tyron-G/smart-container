page {
  min-height: 100vh;
  background: #f6f8fb;
  color: #141a24;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 46rpx;
  box-sizing: border-box;
  background: #f6f8fb;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  box-shadow: 0 14rpx 34rpx rgba(20, 26, 36, 0.08);
}

.section-title {
  color: #141a24;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.muted {
  color: #667085;
}

.primary-button {
  height: 86rpx;
  border-radius: 14rpx;
  background: #2563eb;
  color: #ffffff;
  font-weight: 900;
  font-size: 30rpx;
  line-height: 86rpx;
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.2);
}

.secondary-button {
  height: 82rpx;
  border-radius: 14rpx;
  background: #eaf2ff;
  color: #1d4ed8;
  font-weight: 900;
  font-size: 28rpx;
  line-height: 82rpx;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.page-heading {
  margin-bottom: 24rpx;
}

.page-kicker {
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 900;
}

.page-title {
  margin-top: 8rpx;
  color: #141a24;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.danger-text {
  color: #b5472f;
}
