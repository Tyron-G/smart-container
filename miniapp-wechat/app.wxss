page {
  min-height: 100vh;
  background: #f6f8fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
}

.muted {
  color: #64748b;
}

.primary-button {
  height: 88rpx;
  border-radius: 12rpx;
  background: #2563eb;
  color: #ffffff;
  font-weight: 700;
  font-size: 30rpx;
  line-height: 88rpx;
}

.secondary-button {
  height: 82rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #2563eb;
  font-weight: 700;
  font-size: 28rpx;
  line-height: 82rpx;
}

.danger-text {
  color: #dc2626;
}

