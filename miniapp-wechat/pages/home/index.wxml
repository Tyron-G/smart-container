<view class="home-page">
  <view class="home-topbar">
    <view>
      <view class="brand-name">智柜云购</view>
      <view class="customer-line">客户 {{customerIdText}}</view>
    </view>
    <view class="state-pill {{loggedIn ? 'state-ready' : 'state-wait'}}">{{loggedIn ? '已登录' : '待登录'}}</view>
  </view>

  <view class="hero-panel">
    <view class="hero-copy">
      <view class="hero-kicker">SMART CABINET</view>
      <view class="hero-title">扫码开柜</view>
      <view class="hero-desc">确认设备与仓门后创建订单，取货流程在手机端完成。</view>
      <button class="hero-button" bindtap="goScan">开始扫码</button>
    </view>
    <view class="cabinet-visual" aria-hidden="true">
      <view class="cabinet-top"></view>
      <view class="cabinet-body">
        <view class="cabinet-door door-main"></view>
        <view class="cabinet-column">
          <view class="cabinet-door door-small"></view>
          <view class="cabinet-door door-small active"></view>
          <view class="cabinet-door door-small"></view>
        </view>
      </view>
      <view class="cabinet-base"></view>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="login-strip">
    <view>
      <view class="strip-title">本地演示</view>
      <view class="strip-desc">使用演示用户进入完整流程。</view>
    </view>
    <button class="strip-button" bindtap="demoLogin">演示登录</button>
  </view>

  <view class="quick-grid">
    <view class="quick-card order-card" bindtap="goOrders">
      <view class="quick-icon">单</view>
      <view class="quick-title">我的订单</view>
      <view class="quick-desc">查看状态</view>
    </view>
    <view class="quick-card profile-card" bindtap="goProfile">
      <view class="quick-icon">账</view>
      <view class="quick-title">账户信息</view>
      <view class="quick-desc">绑定资料</view>
    </view>
  </view>

  <view class="process-band">
    <view class="process-item">
      <view class="process-dot accent-teal"></view>
      <view>扫码</view>
    </view>
    <view class="process-line"></view>
    <view class="process-item">
      <view class="process-dot accent-amber"></view>
      <view>开柜</view>
    </view>
    <view class="process-line"></view>
    <view class="process-item">
      <view class="process-dot accent-coral"></view>
      <view>结算</view>
    </view>
  </view>
</view>

