.home-page {
  min-height: 100vh;
  padding: 30rpx 28rpx 46rpx;
  box-sizing: border-box;
  background: #f4f7f2;
  color: #17211b;
}

.home-topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.customer-line {
  margin-top: 8rpx;
  color: #6b756f;
  font-size: 25rpx;
}

.state-pill {
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  text-align: center;
  line-height: 48rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.state-ready {
  background: #d9f5e8;
  color: #087443;
}

.state-wait {
  background: #fff2c9;
  color: #8f5a00;
}

.hero-panel {
  position: relative;
  min-height: 480rpx;
  margin-top: 28rpx;
  padding: 42rpx 34rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #18352c;
  color: #ffffff;
  box-shadow: 0 28rpx 68rpx rgba(31, 64, 52, 0.28);
}

.hero-panel::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 142rpx;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0));
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 430rpx;
}

.hero-kicker {
  color: #f1c35b;
  font-size: 20rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 0;
}

.hero-desc {
  width: 360rpx;
  margin-top: 18rpx;
  color: #cfe0d8;
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-button {
  width: 294rpx;
  height: 86rpx;
  margin: 34rpx 0 0;
  border-radius: 14rpx;
  background: #f1c35b;
  color: #18352c;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 86rpx;
}

.hero-button::after,
.strip-button::after {
  border: 0;
}

.cabinet-visual {
  position: absolute;
  right: 28rpx;
  bottom: 34rpx;
  z-index: 1;
  width: 244rpx;
}

.cabinet-top {
  width: 164rpx;
  height: 24rpx;
  margin-left: 42rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: #d7ded9;
}

.cabinet-body {
  display: flex;
  gap: 10rpx;
  width: 244rpx;
  height: 266rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #eef3ef;
  box-shadow: inset 0 -16rpx 0 rgba(23, 33, 27, 0.12);
}

.cabinet-door {
  border: 2rpx solid #c2cbc4;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.door-main {
  width: 130rpx;
  height: 238rpx;
}

.cabinet-column {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 74rpx;
}

.door-small {
  height: 72rpx;
}

.door-small.active {
  background: #f7d779;
  border-color: #e0b53f;
}

.cabinet-base {
  width: 210rpx;
  height: 22rpx;
  margin-left: 17rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #111c17;
}

.login-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e7dec2;
  border-radius: 18rpx;
  background: #fff9e8;
  box-sizing: border-box;
}

.strip-title {
  color: #17211b;
  font-size: 30rpx;
  font-weight: 900;
}

.strip-desc {
  margin-top: 6rpx;
  color: #7f7046;
  font-size: 24rpx;
}

.strip-button {
  width: 180rpx;
  height: 70rpx;
  margin: 0;
  border-radius: 12rpx;
  background: #18352c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 70rpx;
}

.quick-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.quick-card {
  flex: 1;
  min-height: 176rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #e0e7df;
  box-shadow: 0 14rpx 34rpx rgba(31, 64, 52, 0.08);
}

.quick-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  text-align: center;
  line-height: 54rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.order-card .quick-icon {
  background: #d9f5e8;
  color: #087443;
}

.profile-card .quick-icon {
  background: #ffe1d8;
  color: #a13c24;
}

.quick-title {
  margin-top: 18rpx;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 900;
}

.quick-desc {
  margin-top: 6rpx;
  color: #6b756f;
  font-size: 24rpx;
}

.process-band {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e0e7df;
}

.process-item {
  display: flex;
  align-items: center;
  color: #334239;
  font-size: 25rpx;
  font-weight: 800;
}

.process-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

.accent-teal {
  background: #18a06b;
}

.accent-amber {
  background: #e3a81f;
}

.accent-coral {
  background: #d85a3a;
}

.process-line {
  flex: 1;
  height: 2rpx;
  margin: 0 14rpx;
  background: #dbe4dc;
}
