<view class="page">
  <view class="orders-hero">
    <view>
      <view class="page-kicker">ORDER HISTORY</view>
      <view class="page-title">我的订单</view>
      <view class="page-subtitle">客户 {{session.customerId || '-'}}</view>
    </view>
    <button class="refresh-button" loading="{{loading}}" bindtap="loadOrders">刷新</button>
  </view>

  <view wx:if="{{orders.length === 0 && !loading}}" class="card empty-card">
    <view class="empty-mark">单</view>
    <view class="empty-title">暂无订单</view>
    <view class="muted">扫码开柜后会在这里看到订单。</view>
  </view>

  <view wx:for="{{orders}}" wx:key="orderNo" class="card order-card" bindtap="goDetail" data-order-no="{{item.orderNo}}">
    <view class="order-main">
      <view>
        <view class="order-label">订单号</view>
        <view class="order-no">{{item.orderNo}}</view>
      </view>
      <view class="status">{{item.orderStatusText}}</view>
    </view>
    <view class="order-meta">
      <view>
        <view class="meta-label">设备</view>
        <view class="meta-value">{{item.deviceId || '-'}}</view>
      </view>
      <view>
        <view class="meta-label">金额</view>
        <view class="meta-value amount">¥{{item.payAmount}}</view>
      </view>
    </view>
    <view class="order-time">{{item.createTime || item.trxTime || '暂无时间'}}</view>
  </view>
</view>

