<view class="page">
  <view class="list-header">
    <view>
      <view class="section-title">我的订单</view>
      <view class="muted">客户 {{session.customerId || '-'}}</view>
    </view>
    <button class="refresh-button" loading="{{loading}}" bindtap="loadOrders">刷新</button>
  </view>

  <view wx:if="{{orders.length === 0 && !loading}}" class="card empty-card">
    <view class="empty-title">暂无订单</view>
    <view class="muted">扫码开柜后会在这里看到订单。</view>
  </view>

  <view wx:for="{{orders}}" wx:key="orderNo" class="card order-card" bindtap="goDetail" data-order-no="{{item.orderNo}}">
    <view class="order-main">
      <view class="order-no">{{item.orderNo}}</view>
      <view class="status">{{item.orderStatus}}</view>
    </view>
    <view class="order-meta">设备 {{item.deviceId || '-'}} · 金额 ¥{{item.payAmount || item.orderAmount || '0.00'}}</view>
    <view class="order-time">{{item.createTime || item.trxTime || ''}}</view>
  </view>
</view>

