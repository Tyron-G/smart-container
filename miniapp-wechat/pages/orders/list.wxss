.orders-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.refresh-button {
  width: 132rpx;
  height: 64rpx;
  margin: 8rpx 0 0;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.refresh-button::after {
  border: 0;
}

.empty-card {
  padding: 52rpx 34rpx;
  text-align: center;
}

.empty-mark {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 18rpx;
  border-radius: 22rpx;
  background: #eaf2ff;
  color: #1d4ed8;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.order-card {
  padding: 28rpx;
  margin-bottom: 18rpx;
}

.order-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-label,
.meta-label {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.order-no {
  max-width: 430rpx;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #141a24;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: 0 0 auto;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 900;
}

.order-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.meta-value {
  margin-top: 6rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 900;
}

.amount {
  color: #b5472f;
}

.order-time {
  margin-top: 16rpx;
  color: #667085;
  font-size: 24rpx;
}
