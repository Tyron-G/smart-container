.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.refresh-button {
  min-width: 132rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 24rpx;
  line-height: 64rpx;
}

.empty-card {
  padding: 42rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.order-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
}

.order-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 800;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 700;
}

.order-meta,
.order-time {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}

