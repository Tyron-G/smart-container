.detail-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx;
  background: #151a23;
  color: #ffffff;
}

.detail-title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.detail-no {
  max-width: 470rpx;
  margin-top: 10rpx;
  color: #cbd5e1;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-status {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 900;
}

.amount-card {
  margin-top: 20rpx;
  padding: 30rpx;
  background: #ffffff;
  border-color: #dbe6f5;
}

.amount-label {
  color: #667085;
  font-size: 24rpx;
  font-weight: 900;
}

.amount-value {
  margin-top: 8rpx;
  color: #b5472f;
  font-size: 54rpx;
  font-weight: 900;
}

.amount-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.detail-card {
  padding: 30rpx;
  margin-top: 20rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.detail-row text:first-child {
  flex: 0 0 auto;
  color: #667085;
  font-size: 25rpx;
  font-weight: 800;
}

.detail-row text:last-child {
  min-width: 0;
  text-align: right;
  color: #141a24;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-items {
  padding: 34rpx 0 8rpx;
  color: #667085;
  text-align: center;
  font-size: 25rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.item-name {
  color: #141a24;
  font-weight: 900;
}

.item-price {
  color: #b5472f;
  font-weight: 900;
}
