.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #0f172a;
  color: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.profile-main {
  min-width: 0;
}

.menu-card {
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.menu-row text:first-child {
  color: #64748b;
}

.menu-row text:last-child {
  max-width: 420rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logout-button {
  margin-top: 28rpx;
}

