<view class="page">
  <view class="card profile-card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-main">
      <view class="section-title">{{session.customerId || '未登录'}}</view>
      <view class="muted">{{session.mobile || '暂无手机号'}}</view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-row">
      <text>绑定状态</text>
      <text>{{session.bindStatus ? '已绑定' : '未绑定'}}</text>
    </view>
    <view class="menu-row">
      <text>OpenID</text>
      <text>{{session.openId || '-'}}</text>
    </view>
  </view>

  <button class="secondary-button logout-button" bindtap="logout">退出登录</button>
</view>

