<view class="page login-page">
  <view class="login-hero card">
    <view class="hero-copy">
      <view class="page-kicker">WECHAT MINIAPP</view>
      <view class="login-title">智柜体验助手</view>
      <view class="login-subtitle">登录后可体验扫码识别、记录查看和账户绑定状态。</view>
    </view>
    <view class="brand-mark">
      <view class="brand-door"></view>
      <view class="brand-lines">
        <view></view>
        <view></view>
        <view class="active"></view>
      </view>
    </view>
  </view>

  <view class="login-card card">
    <view class="section-title">登录信息</view>
    <view class="form-field">
      <view class="form-label">体验用户 ID</view>
      <input class="input" value="{{customerId}}" placeholder="请输入体验用户 ID" bindinput="handleCustomerIdInput" />
    </view>

    <view class="form-field">
      <view class="form-label">手机号</view>
      <input class="input" value="{{mobile}}" placeholder="请输入手机号" type="number" bindinput="handleMobileInput" />
    </view>

    <view class="form-actions">
      <button class="primary-button" bindtap="handleWechatLogin">微信登录</button>
      <button class="secondary-button" bindtap="handleDemoLogin">演示登录</button>
    </view>
  </view>
</view>

