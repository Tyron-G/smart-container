.scan-visual {
  padding: 34rpx;
  background: #151a23;
  color: #ffffff;
}

.scan-frame {
  position: relative;
  width: 208rpx;
  height: 208rpx;
  margin: 0 auto;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.08);
}

.corner {
  position: absolute;
  width: 46rpx;
  height: 46rpx;
  border-color: #2f6fed;
  border-style: solid;
}

.left-top {
  left: 18rpx;
  top: 18rpx;
  border-width: 6rpx 0 0 6rpx;
  border-radius: 12rpx 0 0 0;
}

.right-top {
  right: 18rpx;
  top: 18rpx;
  border-width: 6rpx 6rpx 0 0;
  border-radius: 0 12rpx 0 0;
}

.left-bottom {
  left: 18rpx;
  bottom: 18rpx;
  border-width: 0 0 6rpx 6rpx;
  border-radius: 0 0 0 12rpx;
}

.right-bottom {
  right: 18rpx;
  bottom: 18rpx;
  border-width: 0 6rpx 6rpx 0;
  border-radius: 0 0 12rpx 0;
}

.scan-line {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 102rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #2f6fed;
}

.scan-visual-title {
  margin-top: 28rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.scan-visual-desc {
  margin-top: 8rpx;
  text-align: center;
  color: #cbd5e1;
  font-size: 24rpx;
}

.scan-card,
.result-card {
  padding: 30rpx;
}

.scan-card {
  margin-top: 22rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 25rpx;
  font-weight: 900;
}

.input {
  height: 86rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe6f5;
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.result-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  background: #ffffff;
  border-color: #dbe6f5;
}

.success-mark {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: #eaf2ff;
  color: #1d4ed8;
  text-align: center;
  line-height: 62rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.result-main {
  min-width: 0;
  flex: 1;
}

.order-no {
  margin-top: 8rpx;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-line {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
}

.result-actions {
  flex: 0 0 auto;
  display: grid;
  gap: 10rpx;
}

.result-button {
  width: 146rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 64rpx;
}

.result-button.primary-button {
  box-shadow: none;
}
