<view class="page">
  <view class="page-heading">
    <view class="page-kicker">SCAN DEMO</view>
    <view class="page-title">扫码识别</view>
    <view class="page-subtitle">扫描设备二维码后确认仓门信息，生成一条本地体验记录。</view>
  </view>

  <view class="scan-visual card" bindtap="scanCode">
    <view class="scan-frame">
      <view class="corner left-top"></view>
      <view class="corner right-top"></view>
      <view class="corner left-bottom"></view>
      <view class="corner right-bottom"></view>
      <view class="scan-line"></view>
    </view>
    <view class="scan-visual-title">扫码识别设备</view>
    <view class="scan-visual-desc">自动带出设备和仓门信息</view>
  </view>

  <view class="card scan-card">
    <view class="section-title">确认信息</view>
    <view class="field">
      <view class="label">设备 ID</view>
      <input class="input" value="{{deviceId}}" placeholder="如 DEV-002" bindinput="handleDeviceInput" />
    </view>
    <view class="field">
      <view class="label">仓门 ID</view>
      <input class="input" value="{{gateId}}" placeholder="如 GATE-002-01" bindinput="handleGateInput" />
    </view>
    <view class="action-row">
      <button class="secondary-button" bindtap="scanCode">重新扫码</button>
      <button class="primary-button" loading="{{creating}}" bindtap="createOrder">确认体验</button>
    </view>
  </view>

  <view wx:if="{{orderNo}}" class="card result-card">
    <view class="success-mark">成</view>
    <view class="result-main">
      <view class="section-title">记录已生成</view>
      <view class="order-no">{{orderNo}}</view>
      <view class="status-line">当前状态：{{orderStatusText || '-'}}</view>
    </view>
    <view class="result-actions">
      <button class="secondary-button result-button" loading="{{statusLoading}}" bindtap="manualRefreshOrderStatus">刷新</button>
      <button class="primary-button result-button" bindtap="goDetail">详情</button>
    </view>
  </view>
</view>

