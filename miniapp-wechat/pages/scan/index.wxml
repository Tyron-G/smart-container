<view class="page">
  <view class="card scan-card">
    <view class="section-title">设备信息</view>
    <view class="field">
      <view class="label">设备 ID</view>
      <input class="input" value="{{deviceId}}" placeholder="如 DEV-002" bindinput="handleDeviceInput" />
    </view>
    <view class="field">
      <view class="label">仓门 ID</view>
      <input class="input" value="{{gateId}}" placeholder="如 GATE-002-01" bindinput="handleGateInput" />
    </view>
    <view class="action-row">
      <button class="secondary-button" bindtap="scanCode">扫码识别</button>
      <button class="primary-button" loading="{{creating}}" bindtap="createOrder">确认开柜</button>
    </view>
  </view>

  <view wx:if="{{orderNo}}" class="card result-card">
    <view class="section-title">订单已创建</view>
    <view class="order-no">{{orderNo}}</view>
    <button class="secondary-button" bindtap="goDetail">查看订单</button>
  </view>
</view>

