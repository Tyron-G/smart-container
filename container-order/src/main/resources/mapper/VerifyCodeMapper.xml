<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.fuguang.order.mapper.VerifyCodeMapper">
    <resultMap id="BaseResultMap" type="cn.fuguang.entity.VerifyCodeEntity">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="mobile" jdbcType="VARCHAR" property="mobile"/>
        <result column="verify_code" jdbcType="VARCHAR" property="verifyCode"/>
        <result column="order_no" jdbcType="VARCHAR" property="orderNo"/>
        <result column="retry_times" jdbcType="INTEGER" property="retryTimes"/>
        <result column="invalid_time" property="invalidTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.fuguang.entity.VerifyCodeEntity">
        insert into verify_code (mobile, verify_code, order_no,
                                 retry_times, invalid_time, create_time, update_time)
        values (#{mobile,jdbcType=VARCHAR}, #{verifyCode,jdbcType=VARCHAR}, #{orderNo,jdbcType=VARCHAR},
                #{retryTimes,jdbcType=INTEGER}, #{invalidTime}, now(), now())
    </insert>
</mapper>
