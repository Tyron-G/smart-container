.scan-card,
.result-card {
  padding: 30rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #334155;
  font-weight: 700;
}

.input {
  height: 86rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
  background: #f8fafc;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.result-card {
  margin-top: 24rpx;
}

.order-no {
  margin: 20rpx 0;
  color: #2563eb;
  font-size: 34rpx;
  font-weight: 800;
}
